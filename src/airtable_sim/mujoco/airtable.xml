<mujoco model="airtable">

    <compiler angle="degree"/>

    <option timestep="0.002" gravity="0 0 0" />

    <visual>
        <global azimuth="90" elevation="-90" offwidth="1280" offheight="960" />
    </visual>

    <asset>
        <mesh name="marker_card" file="markers/card.obj"/>
        <texture name="marker_10" type="2d" file="markers/marker_10.png"/>
        <texture name="marker_11" type="2d" file="markers/marker_11.png"/>
        <texture name="marker_12" type="2d" file="markers/marker_12.png"/>
        <texture name="marker_13" type="2d" file="markers/marker_13.png"/>
        <texture name="marker_50" type="2d" file="markers/marker_50.png"/>
        <material name="marker_10" texture="marker_10" emission="1" specular="0"/>
        <material name="marker_11" texture="marker_11" emission="1" specular="0"/>
        <material name="marker_12" texture="marker_12" emission="1" specular="0"/>
        <material name="marker_13" texture="marker_13" emission="1" specular="0"/>
        <material name="marker_50" texture="marker_50" emission="1" specular="0"/>
    </asset>

    <worldbody>

        <light pos="0 0 2" dir="0 0 -1" />

        <body name="table_1" pos="0 0 0"> 

            <!-- The render camera looks down -Z; the ROS optical frame flips Y and Z. -->
            <camera name="tracking_camera" pos="0.5 1.0 1.3" xyaxes="0 1 0 -1 0 0" fovy="58" resolution="848 480"/>

            <geom
                name="table_1_surface"
                type="box"
                pos="0.5 1.0 -0.1"
                size="0.5 1.0 0.1"
                rgba="0.85 0.85 0.85 1"
                contype="0" conaffinity="0"
            />

            <!-- Card size 0.15 m includes a white margin; black marker edge is 0.10 m. -->
            <geom name="fixed_marker_10" type="mesh" mesh="marker_card" material="marker_10"
                  pos="0.075 1.925 0.002" mass="0" contype="0" conaffinity="0"/>
            <geom name="fixed_marker_11" type="mesh" mesh="marker_card" material="marker_11"
                  pos="0.925 1.925 0.002" mass="0" contype="0" conaffinity="0"/>
            <geom name="fixed_marker_12" type="mesh" mesh="marker_card" material="marker_12"
                  pos="0.075 0.075 0.002" mass="0" contype="0" conaffinity="0"/>
            <geom name="fixed_marker_13" type="mesh" mesh="marker_card" material="marker_13"
                  pos="0.925 0.075 0.002" mass="0" contype="0" conaffinity="0"/>

        <!-- 外枠 -->
            <geom
                name="table_1_wall_x_min"
                type="box"
                pos="-0.01 1.0 0.05"
                size="0.01 1.0 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_x_max"
                type="box"
                pos="1.01 1.0 0.05"
                size="0.01 1.0 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_y_min"
                type="box"
                pos="0.5 -0.01 0.05"
                size="0.5 0.01 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_y_max"
                type="box"
                pos="0.5 2.01 0.05"
                size="0.5 0.01 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <body name="robot_1" pos="0.5 1.0 0.01">

                <joint name="x" type="slide" axis="1 0 0"/>
                <joint name="y" type="slide" axis="0 1 0"/>
                <joint name="yaw" type="hinge" axis="0 0 1"/>

                <geom name="moving_marker_50" type="mesh" mesh="marker_card" material="marker_50"
                      pos="0 0 0.147" mass="0" contype="0" conaffinity="0"/>

                <geom
                    name="body_geom"
                    type="box"
                    size="0.1 0.1 0.01"
                    mass="1.0"
                    rgba="0.3 0.5 0.8 1.0"
                />

                <!-- Thruster 1 -->
                <body
                    name="thruster_1_mount"
                    pos="0.05 0.09 0.018"
                    euler="0 0 -135"
                >
                    <site
                        name="thruster_1"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_1_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_2_mount"
                    pos="-0.05 0.09 0.018"
                    euler="0 0 -45"
                >
                    <site
                        name="thruster_2"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_2_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_3_mount"
                    pos="0.05 -0.09 0.018"
                    euler="0 0 135"
                >
                    <site
                        name="thruster_3"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_3_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_4_mount"
                    pos="-0.05 -0.09 0.018"
                    euler="0 0 45"
                >

                    <site
                        name="thruster_4"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                        /> 

                    <site
                        name="thruster_4_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <!-- Reaction wheel -->
                <site
                    name="reaction_wheel_1"
                    type="box"
                    pos="0 0 0.015"
                    size="0.015 0.015 0.015"
                    rgba="0.8 0.8 0.2 1"
                />

                <!-- sensor -->
                <site
                    name="imu_1"
                    type="box"
                    pos="0.06 0 0.02"
                    size="0.04 0.04 0.02"
                    euler="0 0 0"
                />
                    
            </body>

        </body>

        <!-- 複数テーブルの場合
        <body name="table_2" pos="5.0 0 0">

            <geom
                name="table_2_surface"
                type="box"
                pos="0.5 1.0 -0.1"
                size="0.5 1.0 0.1"
            />
        </body>
        -->
    

    </worldbody>
        <actuator>
            <motor
                name="thruster_1_actuator"
                site="thruster_1"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_2_actuator"
                site="thruster_2"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_3_actuator"
                site="thruster_3"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_4_actuator"
                site="thruster_4"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="reaction_wheel_1_actuator"
                site="reaction_wheel_1"
                gear="0 0 0 0 0 -1"
            />
        </actuator>

        <sensor>
            <accelerometer
                name="imu_1_accel"
                site="imu_1"
            />

            <gyro
                name="imu_1_gyro"
                site="imu_1"
            />

            <framequat
                name="imu_1_orientation"
                objtype="site"
                objname="imu_1"
            />
        </sensor>
</mujoco>
