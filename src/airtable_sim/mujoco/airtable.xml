<mujoco model="airtable">

    <compiler angle="degree"/>

    <option timestep="0.002" gravity="0 0 0" />

    <visual>
        <global azimuth="90" elevation="-90" />
    </visual>

    <worldbody>

        <light pos="0 0 2" dir="0 0 -1" />

        <body name="table_1" pos="0 0 0"> 

            <site
                name="table_1_surface"
                type="box"
                pos="0.5 1.0 -0.1"
                size="0.5 1.0 0.1"
            />

        <!-- 外枠 -->
            <geom
                name="table_1_wall_x_min"
                type="box"
                pos="-0.01 1.0 0.05"
                size="0.01 1.0 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_x_max"
                type="box"
                pos="1.01 1.0 0.05"
                size="0.01 1.0 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_y_min"
                type="box"
                pos="0.5 -0.01 0.05"
                size="0.5 0.01 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <geom
                name="table_1_wall_y_max"
                type="box"
                pos="0.5 2.01 0.05"
                size="0.5 0.01 0.05"
                rgba="0.5 0.5 0.5 1.0"
                group="2"
                contype="0"
                conaffinity="0"
            />

            <body name="robot_1" pos="0.5 1.0 0.01">

                <joint name="x" type="slide" axis="1 0 0"/>
                <joint name="y" type="slide" axis="0 1 0"/>
                <joint name="yaw" type="hinge" axis="0 0 1"/>

                <geom
                    name="body_geom"
                    type="box"
                    size="0.1 0.1 0.01"
                    mass="10.0"
                    rgba="0.3 0.5 0.8 1.0"
                />

                <!-- Thruster 1 -->
                <body
                    name="thruster_1_mount"
                    pos="0.09 0.09 0.018"
                    euler="0 0 135"
                >
                    <site
                        name="thruster_1"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_1_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_2_mount"
                    pos="0.09 -0.09 0.018"
                    euler="0 0 -135"
                >
                    <site
                        name="thruster_2"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_2_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_3_mount"
                    pos="-0.09 -0.09 0.018"
                    euler="0 0 -45"
                >
                    <site
                        name="thruster_3"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                    />

                    <site
                        name="thruster_3_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>

                <body
                    name="thruster_4_mount"
                    pos="-0.09 0.09 0.018"
                    euler="0 0 45"
                >

                    <site
                        name="thruster_4"
                        type="box"
                        size="0.015 0.008 0.008"
                        rgba="1 0 0 1"
                        /> 

                    <site
                        name="thruster_4_direction"
                        type="capsule"
                        fromto="0 0 0 0.02 0 0"
                        size="0.003"
                        rgba="0 0 1 0.5"
                    />
                </body>
            </body>
        </body>

        <!-- 複数テーブルの場合
        <body name="table_2" pos="5.0 0 0">

            <geom
                name="table_2_surface"
                type="box"
                pos="0.5 1.0 -0.1"
                size="0.5 1.0 0.1"
            />
        </body>
        -->
    

    </worldbody>
        <actuator>
            <motor
                name="thruster_1_actuator"
                site="thruster_1"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_2_actuator"
                site="thruster_2"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_3_actuator"
                site="thruster_3"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />

            <motor
                name="thruster_4_actuator"
                site="thruster_4"
                gear="1 0 0 0 0 0"
                ctrllimited="true"
                ctrlrange="0 0.5"
            />
        </actuator>
</mujoco>
