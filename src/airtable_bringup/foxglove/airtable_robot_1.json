    "StateTransitions!sun_status": {
      "foxglovePanelTitle": "センサ状態（valid / error_code）",
      "paths": [
        {
          "value": "/robot_1/measurements/sun_sensor.valid",
          "label": "valid",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/robot_1/measurements/sun_sensor.error_code",
          "label": "error_code",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "isSynced": true
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1.0
  },
  "layout": "Tab!main"
}
