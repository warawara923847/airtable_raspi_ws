# Generated by: ros2 run airtable_bringup robot_config rviz config/robots/dual_robot.yaml --output rviz/dual_trajectory.rviz
# robots_rviz.launch.py / rviz:=true regenerate this for the selected robots at launch time.
Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: world
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/TF
    Name: TF frames
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.3
    Update Interval: 0
  - Class: rviz_common/Group
    Enabled: true
    Name: robot_1 on table_1
    Displays:
    - Class: rviz_default_plugins/Grid
      Name: table_1 grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Plane: XY
      Alpha: 0.4
      Reference Frame: table_1
      Offset:
        X: 0.5
        Y: 1
        Z: 0
    - Class: rviz_default_plugins/Path
      Name: Reference path (target)
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 40; 230; 100
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Actual path
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/actual_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 70; 150; 255
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: Reference pose (target)
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/reference
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 40; 230; 100
        Shaft Length: 0.15
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Actual pose (/robot_1/sim/ground_truth)
      Enabled: true
      Topic:
        Value: /robot_1/sim/ground_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 70; 150; 255
        Shaft Length: 0.2
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Measured pose (ArUco)
      Enabled: true
      Topic:
        Value: /robot_1/measurements/external_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow
      Color: 255; 80; 200
      Alpha: 1
      Shaft Length: 0.12
      Shaft Radius: 0.008
      Head Length: 0.04
      Head Radius: 0.025
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Wrench
      Name: External disturbance
      Enabled: true
      Topic:
        Value: /robot_1/sim/disturbance/applied
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Force Color: 255; 70; 70
      Torque Color: 255; 220; 40
      Force Arrow Scale: 10
      Torque Arrow Scale: 200
      Arrow Width: 0.015
      History Length: 1
  - Class: rviz_common/Group
    Enabled: true
    Name: robot_2 on table_2
    Displays:
    - Class: rviz_default_plugins/Grid
      Name: table_2 grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Plane: XY
      Alpha: 0.4
      Reference Frame: table_2
      Offset:
        X: 0.5
        Y: 1
        Z: 0
    - Class: rviz_default_plugins/Path
      Name: Reference path (target)
      Enabled: true
      Topic:
        Value: /robot_2/trajectory/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 255; 200; 40
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Actual path
      Enabled: true
      Topic:
        Value: /robot_2/trajectory/actual_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 230; 90; 40
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: Reference pose (target)
      Enabled: true
      Topic:
        Value: /robot_2/trajectory/reference
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 255; 200; 40
        Shaft Length: 0.15
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Actual pose (/robot_2/sim/ground_truth)
      Enabled: true
      Topic:
        Value: /robot_2/sim/ground_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 230; 90; 40
        Shaft Length: 0.2
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Measured pose (ArUco)
      Enabled: true
      Topic:
        Value: /robot_2/measurements/external_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow
      Color: 80; 220; 255
      Alpha: 1
      Shaft Length: 0.12
      Shaft Radius: 0.008
      Head Length: 0.04
      Head Radius: 0.025
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Wrench
      Name: External disturbance
      Enabled: true
      Topic:
        Value: /robot_2/sim/disturbance/applied
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Force Color: 255; 70; 70
      Torque Color: 255; 220; 40
      Force Arrow Scale: 10
      Torque Arrow Scale: 200
      Arrow Width: 0.015
      History Length: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top View
      Target Frame: world
      Scale: 174
      X: 3.0
      Y: 1.0
      Angle: 0
Window Geometry:
  Width: 1300
  Height: 900
