Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: table_1
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Table Grid (0.1 m)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Plane: XY
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
      Offset: {X: 0.5, Y: 1, Z: 0}
    - Class: rviz_default_plugins/Path
      Name: Reference Path (green)
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 40; 230; 100
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Actual Path (blue)
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/actual_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.01
      Color: 70; 150; 255
      Alpha: 1
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: Reference Pose (green)
      Enabled: true
      Topic:
        Value: /robot_1/trajectory/reference
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 40; 230; 100
        Shaft Length: 0.15
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance: {Value: false}
    - Class: rviz_default_plugins/Odometry
      Name: Actual Pose (blue)
      Enabled: true
      Topic:
        Value: /robot_1/sim/ground_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 70; 150; 255
        Shaft Length: 0.20
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.015
      Covariance: {Value: false}
    - Class: rviz_default_plugins/Wrench
      Name: External Disturbance (force red, torque yellow)
      Enabled: true
      Topic:
        Value: /robot_1/sim/disturbance/applied
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Force Color: 255; 70; 70
      Torque Color: 255; 220; 40
      Force Arrow Scale: 10
      Torque Arrow Scale: 200
      Arrow Width: 0.015
      History Length: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top View
      Target Frame: table_1
      Scale: 450
      X: 0.5
      Y: 1.0
      Angle: 0
Window Geometry:
  Width: 1100
  Height: 900
